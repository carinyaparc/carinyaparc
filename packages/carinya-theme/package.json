{
  "name": "@carinya/theme",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Carinya Parc design tokens and Tailwind CSS 4 theme",
  "sideEffects": [
    "css/*.css"
  ],
  "exports": {
