{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "NODE_ENV",
        "MAILERLITE_API_KEY",
        "NEXT_PUBLIC_GTM_ID",
        "PAYLOAD_SECRET",
        "NEON_DATABASE_URL",
        "NEXT_PUBLIC_SERVER_URL",
        "NEXT_PUBLIC_SENTRY_DSN",
        "SENTRY_DSN",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT"
      ]
    },
    "lint": {
      "env": [
        "NODE_ENV",
        "MAILERLITE_API_KEY",
        "NEXT_PUBLIC_GTM_ID",
        "PAYLOAD_SECRET",
        "NEON_DATABASE_URL",
        "NEXT_PUBLIC_SERVER_URL",
        "NEXT_PUBLIC_SENTRY_DSN",
        "SENTRY_DSN",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "NODE_ENV",
        "MAILERLITE_API_KEY",
        "NEXT_PUBLIC_GTM_ID",
        "PAYLOAD_SECRET",
        "NEON_DATABASE_URL",
        "NEXT_PUBLIC_SERVER_URL",
        "NEXT_PUBLIC_SENTRY_DSN",
        "SENTRY_DSN",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.tsx", "src/**/*.ts", "vitest.config.mjs", "vitest.setup.ts"],
      "env": ["NODE_ENV"]
    },
    "clean": {
      "cache": false
    },
    "typecheck": {
      "env": [
        "NODE_ENV",
        "MAILERLITE_API_KEY",
        "NEXT_PUBLIC_GTM_ID",
        "PAYLOAD_SECRET",
        "NEON_DATABASE_URL",
        "NEXT_PUBLIC_SERVER_URL",
        "NEXT_PUBLIC_SENTRY_DSN",
        "SENTRY_DSN",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT"
      ]
    }
  },
  "globalEnv": [
    "NODE_ENV",
    "MAILERLITE_API_KEY",
    "NEXT_PUBLIC_GTM_ID",
    "CI",
    "NEXT_RUNTIME",
    "SESSION_SECRET",
    "SECURITY_CSP_ENABLED",
    "SECURITY_CSP_REPORT_ONLY",
    "SECURITY_CSP_REPORT_URI",
    "CONTACT_FORM_ENABLE",
    "CONTACT_FORM_RATE_LIMITING",
    "CONTACT_RATE_LIMIT_MAX",
    "CONTACT_RATE_LIMIT_WINDOW_HOURS",
    "RESEND_API_KEY",
    "CONTACT_EMAIL_RECIPIENT",
    "CONTACT_EMAIL_FROM",
    "PAYLOAD_SECRET",
    "NEON_DATABASE_URL",
    "NEXT_PUBLIC_SERVER_URL",
    "NEXT_PUBLIC_SENTRY_DSN",
    "SENTRY_DSN",
    "SENTRY_AUTH_TOKEN",
    "SENTRY_ORG",
    "SENTRY_PROJECT"
  ]
}
