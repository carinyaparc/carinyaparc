# Carinya Parc Website - Environment Variables
# Copy this file to .env.local for local development

# Node environment (development, production, test)
NODE_ENV=development

SESSION_SECRET=session_secret

# Google Tag Manager ID for analytics
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# MailerLite API key for newsletter subscription functionality
# Required for the /api/subscribe endpoint to work
MAILERLITE_API_KEY=mailerlite_api_key

# Sentry — error monitoring, tracing, session replay, and logs
# DSN: Settings → Projects → carinyaparc → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Source map uploads: Settings → Auth Tokens (project:releases + org:read)
# Store the token in .env.sentry-build-plugin locally (gitignored) or in Vercel env
SENTRY_AUTH_TOKEN=
SENTRY_ORG=carinya-parc
SENTRY_PROJECT=carinyaparc

# Payload CMS — required for /admin and Payload API routes
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=payload_secret

# Postgres — required for Payload /admin (Neon pooled URL, or local docker — see docker-compose.yml)
NEON_DATABASE_URL=postgresql://payload:payload@localhost:5432/payload

# Public site URL used by Payload admin links
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
