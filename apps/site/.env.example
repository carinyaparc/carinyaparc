# Carinya Parc Website - Environment Variables
# Copy this file to .env.local for local development

# Node environment (development, production, test)
NODE_ENV=development

SESSION_SECRET=session_secret

# Google Tag Manager ID for analytics
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# MailerLite API key for newsletter subscription functionality
# Required for the /api/subscribe endpoint to work
MAILERLITE_API_KEY=mailerlite_api_key

# SENTRY_AUTH_TOKEN variable is picked up by the Sentry Build Plugin.
SENTRY_AUTH_TOKEN=sentry_auth_token

# Sanity CMS Configuration
# =============================================================
# These variables are required for Sanity CMS integration.
# To get these values:
# 1. Navigate to https://sanity.io/manage
# 2. Select your project
# 3. Go to "API" section
# =============================================================

# Sanity Project ID
# Location: Sanity Dashboard → Project Settings
# Format: alphanumeric string (e.g., "abc123xyz")
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here

# Sanity Dataset Name
# Options: "development" (for testing) or "production" (for live content)
# Local development typically uses "development"
NEXT_PUBLIC_SANITY_DATASET=development

# Sanity API Read Token (Viewer Role)
# Location: Sanity Dashboard → API → Tokens → Create New Token
# Permissions: Viewer (read-only)
# Format: Starts with "sk" followed by alphanumeric string
# Used for: Server-side content fetching, draft content access in preview mode
# Security: Server-only, never exposed to client bundles
SANITY_API_READ_TOKEN=sk_your_read_token_here

# Sanity API Write Token (Editor Role) - OPTIONAL
# Location: Sanity Dashboard → API → Tokens → Create New Token
# Permissions: Editor (read/write)
# Format: Starts with "sk" followed by alphanumeric string
# Used for: Content migrations, local Studio development
# Note: Consider excluding from production environment
SANITY_API_WRITE_TOKEN=sk_your_write_token_here

# =============================================================
# Sanity Live Preview Configuration (CP-02-002)
# =============================================================
# These variables enable real-time content preview and live query features.
# Should be enabled in development/preview environments only.
# =============================================================

# Sanity Browser Token for Live Preview - DEVELOPMENT/PREVIEW ONLY
# Location: Sanity Dashboard → API → Tokens → Create New Token
# Permissions: Viewer (read-only)
# Format: Starts with "sk" followed by alphanumeric string
# Used for: Browser-side live content updates in development/preview
# Security: Excluded from production builds via conditional exports
# Note: Leave unset in production environments
NEXT_PUBLIC_SANITY_API_READ_TOKEN=sk_your_browser_token_here

# Enable Live Preview Mode
# Options: "enabled" or "disabled"
# Default: "disabled"
# When enabled: sanityFetch can access draft content with server token
# Environments: Enable in development/preview, disable in production
SANITY_PREVIEW_MODE=enabled

# Enable Live Preview Real-Time Updates
# Options: "true" or "false"
# Default: "false" in production, "true" in development
# When enabled: SanityLive component establishes WebSocket connection for real-time updates
# Environments: Enable in development/preview only
NEXT_PUBLIC_ENABLE_LIVE_PREVIEW=true

# Sanity Revalidation Secret - OPTIONAL
# Format: Minimum 32 characters, random string
# Used for: Webhook-based cache revalidation (future feature)
# Generate with: openssl rand -base64 32
# SANITY_REVALIDATE_SECRET=your_revalidation_secret_here