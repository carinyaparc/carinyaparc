{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": "^24.10.0"
  },
  "browserslist": [
    "last 2 versions",
    "not dead",
    "> 0.1%"
  ],
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf .next",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run ./src",
    "test:integration": "vitest run ./__tests__/integration",
    "test:smoke": "vitest run ./__tests__/smoke",
    "test:security": "vitest run ./__tests__/security",
    "test:ci": "vitest run --reporter=junit --reporter=default --outputFile=junit.xml",
    "optimize-images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "latest",
    "@hookform/resolvers": "^5.2.2",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.1.1",
    "@next/third-parties": "^16.1.1",
    "@portabletext/react": "^6.0.2",
    "@repo/ui": "workspace:*",
    "@sanity/image-url": "^2.0.2",
    "@sanity/vision": "^5.1.0",
    "@sentry/nextjs": "^10.32.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.90.16",
    "@types/mdx": "^2.0.13",
    "@types/uuid": "^11.0.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "clsx": "^2.1.1",
    "date-fns": "4.1.0",
    "eslint-plugin-turbo": "^2.7.2",
    "framer-motion": "latest",
    "fs": "0.0.1-security",
    "gray-matter": "^4.0.3",
    "import-in-the-middle": "^2.0.1",
    "isomorphic-dompurify": "^2.35.0",
    "jose": "^6.1.3",
    "lucide-react": "^0.562.0",
    "minimatch": "^10.1.1",
    "next": "16.1.1",
    "next-sanity": "^12.0.8",
    "path": "^0.12.7",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.70.0",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "require-in-the-middle": "^8.0.1",
    "resend": "^6.6.0",
    "sanity": "^5.1.0",
    "styled-components": "^6.1.19",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^13.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@playwright/test": "^1.57.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/minimatch": "^6.0.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "cross-env": "^10.1.0",
    "cssnano": "^7.1.2",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.1.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "glob": "^13.0.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.7.4",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
