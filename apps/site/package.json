{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": "24.16.0"
  },
  "browserslist": [
    "last 2 versions",
    "not dead",
    "> 0.1%"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "postbuild": "vitest run src/lib/performance/static-route-assertion.test.ts -t \"production build route classification\"",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf .next",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "payload": "payload",
    "test": "vitest run",
    "import:content-seeds": "tsx scripts/import-content-seed.ts",
    "import:content-seeds:validate": "tsx scripts/validate-content-seeds.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
